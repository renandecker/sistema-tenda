# TEF Integration Configuration
# Copy to .env.local and adjust values

# TEF Agent URL (HTTP for commands)
VITE_TEF_HTTP_URL=http://localhost:8080

# TEF Agent URL (WebSocket for real-time events)
VITE_TEF_WS_URL=ws://localhost:8081

# Ngrok URL for external access (e.g., https://abc123.ngrok.io)
# When set, the frontend will use this URL instead of localhost
VITE_NGROK_URL=

# TEF Auto-connect on app start
VITE_TEF_AUTO_CONNECT=true

# TEF Timeout (ms)
VITE_TEF_TIMEOUT=120000