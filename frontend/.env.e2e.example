# Credenciais e endpoints para os testes E2E do Playwright (stack real).
# Copie para .env.e2e e ajuste conforme o ambiente. NUNCA versione credenciais reais.

# Usuario usado para os testes de ponta a ponta
E2E_LOGIN=admin@sistematenda.com
E2E_SENHA=123456

# Rotas usadas pelo Playwright
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:8080/api

# Banco de dados (mesmos valores do docker-compose.yml), usados para o reset/seeding via psql
E2E_DB_HOST=localhost
E2E_DB_PORT=5433
E2E_DB_NAME=sistematenda
E2E_DB_USER=sistematenda
E2E_DB_PASSWORD=sistematenda

# Container do banco (docker exec) para os scripts de seeding
E2E_DB_CONTAINER=sistematenda-db

# Comando para subir o frontend durante os testes (webServer do Playwright)
E2E_WEB_COMMAND=npm run dev
