# =============================================================================
# Sistema Tenda - Variaveis de Ambiente
# =============================================================================
# Carregado pelo Quarkus (dev), Docker Compose e pelos scripts run/prod.
# NAO versionar este arquivo: ele contem dados sensiveis.
# Nomes seguem o padrao de environment variables do Quarkus
# (prefixo em maiusculas, pontos e hifens viram "_").
#
# =============================================================================
# Observability & Monitoring Configuration
# =============================================================================
# Ativação/Desativação dos serviços de monitoramento (true/false)
VITE_ENABLE_POSTHOG=false
VITE_ENABLE_BUGSNAG=false
VITE_ENABLE_SENTRY=false
VITE_ENABLE_GRAFANA_FARO=false
VITE_ENABLE_DYNATRACE_OTEL=false
VITE_ENABLE_OPENTELEMETRY=false
VITE_ENABLE_REACT_SCAN=false
VITE_ENABLE_REACT_PROFILER=false
VITE_ENABLE_REACT_DEVTOOLS=false
VITE_ENABLE_ROLLBAR=false

# Dynatrace/OpenTelemetry Endpoint
# Set VITE_OTEL_EXPORTER_OTLP_ENDPOINT to your Dynatrace OTLP endpoint:
#   SaaS: https://<account-id>.live.dynatrace.com/api/v1/otlp
#   Managed: https://<cluster-url>/api/v1/otlp
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Rollbar Error Monitoring
VITE_ROLLBAR_ACCESS_KEY=

# Grafana Faro Configuration
VITE_GRAFANA_FARO_URL=

# Sentry DSN
VITE_SENTRY_DSN=

# PostHog Configuration
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Bugsnag Configuration
VITE_BUGSNAG_API_KEY=

# -----------------------------------------------------------------------------
# Fiscal (NFC-e / NF-e / SPED)
# -----------------------------------------------------------------------------
FISCAL_AMBIENTE=HOMOLOGACAO
FISCAL_CERTIFICADO_PATH=./certificado.pfx
FISCAL_CERTIFICADO_SENHA=
FISCAL_CSC=GFYTFGKJYHVUYJKHGFJY
FISCAL_CSC_ID=000001
FISCAL_UF=RS
FISCAL_MUNICIPIO_CODIGO=4311403
FISCAL_MUNICIPIO_NOME=Lajeado
FISCAL_CNPJ=19393430000149
FISCAL_INSCRICAO_ESTADUAL=0720195730
FISCAL_INSCRICAO_MUNICIPAL=000000
FISCAL_CRT=1
FISCAL_RAZAO_SOCIAL=SEVERALTO ALVES DE FREITAS LTDA
FISCAL_NOME_FANTASIA=SEVERALTO ALVES DE FREITAS
FISCAL_ENDERECO=EST RS 130, 3701, MONTANHA
FISCAL_CEP=95901150
FISCAL_FONE=51097519544
FISCAL_EMAIL=escritorio@suhre.com.br
FISCAL_SERIE_NFCE=1
FISCAL_NUMERO_NFCE_INICIAL=1
FISCAL_SERIE_NFE=1
FISCAL_NUMERO_NFE_INICIAL=1
FISCAL_MODELO_DANFE=1
FISCAL_LOGO_PATH=/caminho/para/logo.png
FISCAL_WEBSERVICE_TIMEOUT=30000
FISCAL_SCHEMAS_PATH=schemas/
FISCAL_CFOP_PADRAO=5102
FISCAL_CFOP_INTERESTADUAL=6102
FISCAL_ALIQUOTA_ICMS_PADRAO=18.00
FISCAL_ALIQUOTA_PIS_PADRAO=1.65
FISCAL_ALIQUOTA_COFINS_PADRAO=7.60
FISCAL_NFCE_ENABLED=true

# -----------------------------------------------------------------------------
# PIX Multi-Provider
# Provedor ativo: EFI, MERCADO_PAGO, ASAAS, ITAU, BRADESCO, SICOOB, SICREDI
# -----------------------------------------------------------------------------
PIX_PROVIDER=EFI
PIX_SANDBOX=true
PIX_CHAVE_PIX=sua-chave-pix@exemplo.com
PIX_WEBHOOK_BASE_URL=https://seu-dominio.com
PIX_EXPIRACAO_PADRAO_SEGUNDOS=3600

# EFI (GERENCIANET)
# PIX_EFI_CLIENT_ID=seu_client_id
# PIX_EFI_CLIENT_SECRET=seu_client_secret
# PIX_EFI_CERTIFICADO_P12_PATH=/caminho/para/certificado.p12
# PIX_EFI_CERTIFICADO_SENHA=senha_do_certificado
# PIX_EFI_PIX_CERTIFICADO_PATH=/caminho/para/pix_certificado.pem

# MERCADO PAGO
# PIX_MERCADO_PAGO_ACCESS_TOKEN=APP_USR-SEU_ACCESS_TOKEN
# PIX_MERCADO_PAGO_PUBLIC_KEY=APP_USR-SEU_PUBLIC_KEY
# PIX_MERCADO_PAGO_WEBHOOK_SECRET=seu_webhook_secret

# ASAAS
# PIX_ASAAS_API_KEY=SEU_API_KEY_ASAAS
# PIX_ASAAS_WEBHOOK_TOKEN=SEU_WEBHOOK_TOKEN

# ITAU (OPEN FINANCE)
# PIX_ITAU_CLIENT_ID=seu_client_id_itau
# PIX_ITAU_CLIENT_SECRET=seu_client_secret_itau
# PIX_ITAU_CERTIFICADO_PATH=/caminho/para/certificado_itau.p12
# PIX_ITAU_CERTIFICADO_SENHA=senha_certificado_itau
# PIX_ITAU_CHAVE_PIX=sua-chave-pix-itau@exemplo.com
# PIX_ITAU_AMBIENTE=sandbox

# BRADESCO (OPEN FINANCE)
# PIX_BRADESCO_CLIENT_ID=seu_client_id_bradesco
# PIX_BRADESCO_CLIENT_SECRET=seu_client_secret_bradesco
# PIX_BRADESCO_CERTIFICADO_PATH=/caminho/para/certificado_bradesco.p12
# PIX_BRADESCO_CERTIFICADO_SENHA=senha_certificado_bradesco
# PIX_BRADESCO_CHAVE_PIX=sua-chave-pix-bradesco@exemplo.com
# PIX_BRADESCO_AMBIENTE=sandbox

# -----------------------------------------------------------------------------
# Balanca / Scale
# -----------------------------------------------------------------------------
SCALE_PORT=COM1
SCALE_BAUD_RATE=9600
SCALE_DATA_BITS=8
SCALE_STOP_BITS=1
SCALE_PARITY=NONE
SCALE_TIMEOUT_MS=5000
SCALE_PROTOCOL=TOLEDO
SCALE_AUTO_CONNECT=true
SCALE_RECONNECT_INTERVAL_MS=10000

# -----------------------------------------------------------------------------
# Caixa - Fechamento automatico (formato HH:mm)
# -----------------------------------------------------------------------------
CAIXA_AUTO_CLOSE_HORA=23:30