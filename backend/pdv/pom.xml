<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.sistematenda</groupId>
        <artifactId>sistema-tenda-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>sistema-tenda-pdv</artifactId>
    <name>Sistema Tenda - PDV Module</name>

    <dependencies>
        <dependency>
            <groupId>br.com.sistematenda</groupId>
            <artifactId>sistema-tenda-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.sistematenda</groupId>
            <artifactId>sistema-tenda-fruteira</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.sistematenda</groupId>
            <artifactId>sistema-tenda-buffet</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.sistematenda</groupId>
            <artifactId>sistema-tenda-estoque</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.sistematenda</groupId>
            <artifactId>sistema-tenda-fiscal</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Scheduler for auto-close caixa -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>

        <!-- WebSocket for real-time updates -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-websockets</artifactId>
        </dependency>

        <!-- TEF integration -->
        <dependency>
            <groupId>org.eclipse.paho</groupId>
            <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
            <version>1.2.5</version>
        </dependency>

        <!-- PIX Providers -->
        <!-- Efí (Gerencianet) and Asaas providers use the Quarkus REST client directly -->

        <!-- Mercado Pago -->
        <dependency>
            <groupId>com.mercadopago</groupId>
            <artifactId>sdk-java</artifactId>
            <version>2.4.0</version>
        </dependency>

        <!-- HTTP Client for Open Finance (Itaú/Bradesco) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client-reactive</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client-reactive-jackson</artifactId>
        </dependency>

        <!-- JSON Processing -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>