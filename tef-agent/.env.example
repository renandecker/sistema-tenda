# TEF Agent Configuration
# Copy to .env and adjust values

# Server ports
PORT=8080
WS_PORT=8081

# Ngrok configuration
# Set NGROK_URL to expose this service via Ngrok (e.g., https://abc123.ngrok.io)
# When set, the TEF agent will use this URL for external connections
NGROK_URL=http://localhost:8080

# Logging
LOG_LEVEL=info

# TEF Mode
# Set to 'false' to use real DLL (requires TEF_DLL_PATH)
# Set to 'true' to use simulator (default for development)
USE_SIMULATOR=true

# Real TEF DLL Configuration (when USE_SIMULATOR=false)
# Path to CliSiTef32.dll or CliSiTef64.dll from your TEF provider
# TEF_DLL_PATH=C:\Program Files\Software Express\SiTef\CliSiTef64.dll

# TEF Provider Settings (for real integration)
# TEF_PROVIDER=SITEF|CAPPTA|PAYGO|STONE|LINX
# TEF_CODIGO_CREDENCIADORA=123456
# TEF_TERMINAL_ID=001

# Pinpad Settings
# PINPAD_TIPO=GERTEC|VERIFONE|INGENICO
# PINPAD_PORTA=USB|SERIAL|TCP
# PINPAD_IP=192.168.1.100
# PINPAD_PORTA_TCP=10001

# NFC-e Integration (optional)
# NFCE_ENABLED=true
# NFCE_CSC=seu_csc_aqui
# NFCE_ID_CSC=123

# Health Check Configuration
# Intervalo entre verificações de saúde (aceita 30m, 15m, 2h; off desliga)
SAUDE_INTERVALO=1h
# Primeira conferência roda 1 minuto após o serviço iniciar
SAUDE_PRIMEIRA_EM=1m
# URL do agente TEF (para quando o agente rodar em outro computador)
SAUDE_TEF_URL=http://localhost:8080

# Modo de operação do health check
# Quando SAUDE_INTERVALO=off, a verificação é desabilitada
# Valores válidos: 30m, 15m, 1h, 2h, off